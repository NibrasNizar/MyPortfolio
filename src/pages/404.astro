---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist. Try the projects, courses, or about page instead.">
  <div class="mx-auto flex max-w-2xl flex-col items-center px-6 py-32 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
      This page doesn't exist.
    </h1>
    <p class="mt-4 text-muted-foreground">
      The link might be stale, or the page moved. Here's where you probably meant to go.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground transition-transform hover:-translate-y-0.5"
      >
        Home
      </a>
      <a
        href="/projects"
        class="rounded-md border border-border px-6 py-3 text-sm font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
      >
        Projects
      </a>
      <a
        href="/courses"
        class="rounded-md border border-border px-6 py-3 text-sm font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
      >
        Courses
      </a>
    </div>
  </div>
</BaseLayout>
