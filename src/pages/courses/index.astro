---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CourseCard from '../../components/CourseCard.astro';
import { withBase } from '../../lib/url';

const courses = await getCollection('courses');

const levels = [
  {
    key: 'no-code',
    label: 'No-Code Builder',
    description: 'Zero coding background required: build web apps, AI features, and mobile apps with visual, drag-and-drop tools.',
  },
  {
    key: 'low-code',
    label: 'Low-Code Developer',
    description: 'The same ground, covered faster: light custom code, real APIs, and real databases layered onto visual builders.',
  },
  {
    key: 'ai-native',
    label: 'AI-Native Engineer',
    description: 'Full code-level development, AI-assisted: Python, C++, MLOps engineering, and production GenAI systems.',
  },
  {
    key: 'career',
    label: 'Career Track: Systems & Interviews',
    description: 'The pathway to a senior engineering career: data structures & algorithms, system design, and competitive problem solving.',
  },
] as const;

const tracks = [
  {
    key: 'foundations',
    label: 'Foundations',
    description: 'Python, C++, and the DSA that actually shows up in ML infrastructure work.',
  },
  {
    key: 'mlops',
    label: 'MLOps Engineering',
    description: 'Pipelines, containers, CI/CD, cloud serving, and the cost/observability discipline to run it all in production.',
  },
  {
    key: 'genai',
    label: 'AI / GenAI',
    description: 'LLM fundamentals through production-grade agentic systems.',
  },
] as const;

const coursesByLevel = levels.map((level) => ({
  ...level,
  courses: courses.filter((c) => c.data.level === level.key).sort((a, b) => a.data.order - b.data.order),
}));

const aiNativeByTrack = tracks.map((track) => ({
  ...track,
  courses: courses.filter((c) => c.data.level === 'ai-native' && c.data.track === track.key).sort((a, b) => a.data.order - b.data.order),
}));
---

<BaseLayout
  title="Courses"
  description="A four-level learning ladder: No-Code Builder, Low-Code Developer, AI-Native Engineer, and Career Track: Systems & Interviews."
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow="A ladder, not a leap"
      title="Learn to build, at whatever level you're starting from"
      description="Four levels, in order: No-Code Builder → Low-Code Developer → AI-Native Engineer → Career Track. Start wherever you are, and each level teaches the patterns used in the production case studies on this site."
    />

    <div class="mt-10 flex flex-wrap items-center gap-3">
      {
        levels.map((level, i) => (
          <>
            <span class="rounded-full border border-accent/40 bg-accent/10 px-4 py-2 font-mono text-sm text-accent">
              {level.label}
            </span>
            {i < levels.length - 1 && (
              <span class="text-muted-foreground" aria-hidden="true">
                →
              </span>
            )}
          </>
        ))
      }
    </div>

    <div class="mt-16 space-y-16">
      {
        coursesByLevel.map((level) => (
          <div>
            <h2 class="text-2xl font-semibold text-foreground">{level.label}</h2>
            <p class="mt-2 max-w-2xl text-sm text-muted-foreground">{level.description}</p>

            {level.key === 'ai-native' ? (
              <div class="mt-6 space-y-10">
                {aiNativeByTrack.map((track) => (
                  <div>
                    <h3 class="font-mono text-sm uppercase tracking-wide text-muted-foreground">{track.label}</h3>
                    <p class="mt-1 max-w-2xl text-sm text-muted-foreground">{track.description}</p>
                    <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                      {track.courses.map((course) => (
                        <CourseCard
                          href={withBase(`/courses/${course.id}`)}
                          title={course.data.title}
                          summary={course.data.summary}
                          status={course.data.status}
                        />
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {level.courses.map((course) => (
                  <CourseCard
                    href={withBase(`/courses/${course.id}`)}
                    title={course.data.title}
                    summary={course.data.summary}
                    status={course.data.status}
                  />
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
