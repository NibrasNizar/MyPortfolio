---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotifyForm from '../../components/NotifyForm.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);

const trackLabels: Record<string, string> = {
  foundations: 'Foundations',
  mlops: 'MLOps Engineering',
  genai: 'AI / GenAI',
};
---

<BaseLayout title={course.data.title} description={course.data.summary}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <a href="/courses" class="font-mono text-sm text-accent hover:underline">← All courses</a>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class="rounded-full border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-muted-foreground">
        {trackLabels[course.data.track]}
      </span>
      {
        course.data.status === 'coming-soon' ? (
          <span class="rounded-full border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-muted-foreground">
            Coming soon
          </span>
        ) : (
          <span class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-xs uppercase tracking-wide text-accent">
            Available
          </span>
        )
      }
    </div>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{course.data.title}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{course.data.summary}</p>

    <div class="prose prose-invert prose-headings:font-semibold prose-a:text-accent mt-10 max-w-none">
      <Content />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold text-foreground">What you'll learn</h2>
      <ul class="mt-4 space-y-2">
        {
          course.data.outcomes.map((outcome) => (
            <li class="flex gap-3 text-sm text-muted-foreground">
              <span class="mt-0.5 text-accent" aria-hidden="true">✓</span>
              <span>{outcome}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold text-foreground">Module outline</h2>
      <div class="mt-4 space-y-4">
        {
          course.data.modules.map((mod, i) => (
            <div class="rounded-lg border border-border p-4">
              <p class="font-mono text-xs text-accent">Module {i + 1}</p>
              <p class="mt-1 font-medium text-foreground">{mod.title}</p>
              <ul class="mt-2 space-y-1">
                {mod.lessons.map((lesson) => (
                  <li class="text-sm text-muted-foreground">• {lesson}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {
      course.data.prerequisites.length > 0 && (
        <div class="mt-10">
          <h2 class="text-xl font-semibold text-foreground">Prerequisites</h2>
          <p class="mt-3 text-sm text-muted-foreground">{course.data.prerequisites.join(' · ')}</p>
        </div>
      )
    }

    {course.data.status === 'coming-soon' && (
      <div class="mt-12">
        <NotifyForm courseTitle={course.data.title} />
      </div>
    )}
  </article>
</BaseLayout>
