---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AvailabilityBadge from '../components/AvailabilityBadge.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../lib/url';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const credentials = [
  'AWS Certified Machine Learning – Specialty (2025)',
  'MLOps Specialization, Duke University (2025)',
  'Google AI Essentials (2025)',
  'ISRO "Respond Basket" Grant, ₹1.8M (2022)',
  '2× Intel "Above & Beyond" Award (2022, 2023)',
];

const personId = new URL(withBase('/#person'), Astro.site).toString();
const extraJsonLd = [
  {
    '@type': 'ProfilePage',
    mainEntity: { '@id': personId },
    url: new URL(withBase('/about'), Astro.site).toString(),
  },
];
---

<BaseLayout
  title="About"
  description="Engineering philosophy, selected work, and credentials for Nibras Ahmed Nizar, MLOps Engineer and Technical Lead."
  extraJsonLd={extraJsonLd}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <SectionHeading eyebrow="About" title="Nibras Ahmed Nizar" />

    <div class="prose dark:prose-invert prose-headings:font-semibold prose-a:text-accent mt-8 max-w-none">
      <p>
        I'm an MLOps Engineer and Technical Lead with six-plus years delivering production
        AI/ML systems for global semiconductor enterprises, from classical ML in quality
        assurance to leading the architecture of a chat-first agentic AI platform serving
        hundreds of engineers. I own the full ML lifecycle: data ingestion, model serving,
        CI/CD, and the agentic AI applications sitting on top of all of it.
      </p>
      <p>
        I write strongly typed, well-documented Python: Google-style docstrings, async-first
        I/O, and production observability built in from the start rather than bolted on after
        an incident. I work to explicit quality gates: linting, security scanning, 80%+ test
        coverage. I structure work as concrete artifacts (task boards, roadmaps, stakeholder
        decks) and communicate on a predictable weekly cadence rather than an ad hoc one. I
        surface trade-offs across options before committing to a direction, and I use AI
        tooling pragmatically as a thought partner for both strategy and execution, which is
        also why I ended up as my current team's internal AI-adoption champion.
      </p>
    </div>

    <!-- Now / availability -->
    <div class="mt-12 rounded-xl border border-accent/40 bg-accent/5 p-6">
      <p class="font-mono text-xs uppercase tracking-wide text-accent">Now</p>
      <div class="mt-3">
        <AvailabilityBadge compact />
      </div>
      <p class="mt-3 text-sm text-muted-foreground">
        Leading agentic AI + MLOps delivery for a semiconductor enterprise client.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background/60 px-3 py-1.5 text-xs text-foreground">
          <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Bengaluru · relocation-open
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background/60 px-3 py-1.5 text-xs text-foreground">
          <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Remote-first, thrives in-room
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background/60 px-3 py-1.5 text-xs text-foreground">
          <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          IST (UTC+5:30) · overlaps PST
        </span>
      </div>
    </div>

    <!-- Selected work -->
    <div class="mt-12">
      <h2 class="text-xl font-semibold text-foreground">Selected work</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-2">
        {
          featuredProjects.map((project) => (
            <ProjectCard
              href={withBase(`/projects/${project.id}`)}
              title={project.data.title}
              summary={project.data.summary}
              stack={project.data.stack}
              headlineMetric={project.data.metrics[0]}
            />
          ))
        }
      </div>
      <a href={withBase('/projects')} class="mt-4 inline-block font-mono text-sm text-accent hover:underline">
        See all 7 projects →
      </a>
    </div>

    <!-- Credentials & recognition -->
    <div class="mt-12">
      <h2 class="text-xl font-semibold text-foreground">Credentials &amp; recognition</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          credentials.map((item) => (
            <span class="rounded-full border border-border bg-primary/20 px-3 py-1.5 text-xs text-foreground">
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
