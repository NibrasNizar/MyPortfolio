---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetricCounter from '../components/MetricCounter.astro';
import TagBadge from '../components/TagBadge.astro';
import AvailabilityBadge from '../components/AvailabilityBadge.astro';
import heroDarkSrc from '../assets/hero-dark.jpg';
import heroLightSrc from '../assets/hero-light.jpg';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const heroWidths = [640, 1024, 1600, 1920];

async function buildResponsiveHero(src: typeof heroDarkSrc) {
  const variants = await Promise.all(
    heroWidths.map((width) => getImage({ src, width, format: 'webp', quality: 65 }))
  );
  return {
    src: variants[variants.length - 1].src,
    srcset: variants.map((v, i) => `${v.src} ${heroWidths[i]}w`).join(', '),
  };
}

const heroDark = await buildResponsiveHero(heroDarkSrc);
const heroLight = await buildResponsiveHero(heroLightSrc);

const skillGroups = [
  {
    label: 'Languages & Frameworks',
    skills: ['Python', 'C++', 'SQL', 'TypeScript', 'FastAPI', 'React'],
  },
  {
    label: 'ML & GenAI Orchestration',
    skills: ['LangGraph', 'LangChain', 'MLflow 3.x', 'XGBoost', 'TensorFlow', 'PyTorch', 'RT-DETR', 'ONNX'],
  },
  {
    label: 'MLOps & DevOps Infrastructure',
    skills: ['Databricks', 'Docker', 'Kubernetes', 'Jenkins', 'Terraform', 'OpenShift (ARO)', 'AWS', 'Azure'],
  },
  {
    label: 'Data & Quality',
    skills: ['PostgreSQL', 'SonarQube', 'Bandit', 'Pytest', 'OAuth M2M'],
  },
];
---

<BaseLayout
  title="Nibras Ahmed Nizar · MLOps Engineer, Agentic AI & GenAI Systems"
  description="MLOps Engineer and Technical Lead building production agentic AI and ML platforms at enterprise scale: LangGraph agents serving 300+ users, serverless model serving, and 50% cloud-cost reduction."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <img
      id="hero-img-dark"
      src={heroDark.src}
      srcset={heroDark.srcset}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-[43%_52%] opacity-100 brightness-150 saturate-125 transition-opacity duration-700 ease-snappy"
    />
    <img
      id="hero-img-light"
      src={heroLight.src}
      srcset={heroLight.srcset}
      sizes="100vw"
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover object-[47%_37%] opacity-0 transition-opacity duration-700 ease-snappy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-background/30 via-background/45 to-background"
    >
    </div>

    <div class="relative mx-auto max-w-4xl px-6 py-24 text-center sm:py-32">
      <div class="flex justify-center">
        <AvailabilityBadge glass />
      </div>

      <h1
        class="mt-6 text-4xl font-semibold tracking-tight text-foreground [text-shadow:0_2px_24px_rgb(0_0_0_/_0.25)] sm:text-6xl"
      >
        Nibras Ahmed Nizar
      </h1>
      <p class="mt-3 font-mono text-lg text-accent sm:text-xl">
        MLOps Engineer · Agentic AI & GenAI Systems
      </p>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        I take ML systems from notebook to production: a LangGraph agent serving{' '}
        <span class="text-foreground">300+ users</span> at a semiconductor enterprise, and a
        serverless migration that cut quarterly cloud spend by{' '}
        <span class="text-foreground">50%</span>.
      </p>
      <p class="mx-auto mt-3 max-w-2xl font-mono text-sm text-muted-foreground">
        Production agentic AI + MLOps at enterprise scale · Arabic-speaking · Gulf-market-ready
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/projects"
          class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground transition-transform duration-200 ease-snappy hover:-translate-y-0.5 active:scale-[0.97] active:duration-100"
        >
          View work
        </a>
        <a
          href="/courses"
          class="glass rounded-md px-6 py-3 text-sm font-medium text-foreground transition-transform duration-200 ease-snappy hover:-translate-y-0.5 active:scale-[0.97] active:duration-100"
        >
          Courses
        </a>
        <a
          href="/resume.pdf"
          download
          class="glass rounded-md px-6 py-3 text-sm font-medium text-foreground transition-transform duration-200 ease-snappy hover:-translate-y-0.5 active:scale-[0.97] active:duration-100"
        >
          Download resume
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var darkImg = document.getElementById('hero-img-dark');
      var lightImg = document.getElementById('hero-img-light');
      if (!darkImg || !lightImg) return;
      function syncHeroBg() {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        darkImg.style.opacity = isLight ? '0' : '1';
        lightImg.style.opacity = isLight ? '1' : '0';
      }
      syncHeroBg();
      new MutationObserver(syncHeroBg).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    })();
  </script>

  <!-- Metric strip -->
  <section class="bg-gradient-to-b from-background via-accent/8 to-background">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        <MetricCounter value={6} suffix="+" label="Years of experience" />
        <MetricCounter value={300} suffix="+" label="Active agent users" />
        <MetricCounter value={50} suffix="%" label="Cloud cost cut" />
        <MetricCounter value={6} suffix="+" label="Production ML models" />
        <MetricCounter value={1.8} prefix="₹" decimals={1} suffix="M" label="ISRO grant secured" />
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      eyebrow="Selected work"
      title="Three ways I've moved the needle"
      description="Agentic AI in production, a platform migration that changed the cost model, and the architecture call that halved a budget line. Full case studies: problem, architecture, decisions, outcome."
    />

    <div class="perspective mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            summary={project.data.summary}
            stack={project.data.stack}
            headlineMetric={project.data.metrics[0]}
          />
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a href="/projects" class="font-mono text-sm text-accent hover:underline">
        See all 7 projects →
      </a>
    </div>
  </section>

  <!-- Social proof -->
  <section class="bg-gradient-to-b from-background via-accent/8 to-background">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="text-center sm:text-left">
          <p class="font-mono text-sm text-accent">Recognition</p>
          <p class="mt-2 text-sm text-muted-foreground">
            2× Intel "Above & Beyond" awards: Results Driven (2023) & Customer First (2022)
          </p>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-mono text-sm text-accent">Certified</p>
          <p class="mt-2 text-sm text-muted-foreground">
            AWS Certified Machine Learning – Specialty · MLOps Specialization, Duke University
          </p>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-mono text-sm text-accent">Trusted by</p>
          <p class="mt-2 text-sm text-muted-foreground">
            Teams at Intel · Applied Materials (via UST) · ISRO-funded research
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading eyebrow="Toolbox" title="Skills, grouped by how I actually use them" />

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        skillGroups.map((group) => (
          <div>
            <p class="font-mono text-xs uppercase tracking-wide text-muted-foreground">{group.label}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <TagBadge label={skill} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
