---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetricCounter from '../components/MetricCounter.astro';
import AvailabilityBadge from '../components/AvailabilityBadge.astro';
import SkillCloud from '../components/SkillCloud.astro';
import heroDarkSrc from '../assets/hero-dark.jpg';
import heroLightSrc from '../assets/hero-light.jpg';
import {
  siPython,
  siCplusplus,
  siTypescript,
  siFastapi,
  siReact,
  siLanggraph,
  siLangchain,
  siMlflow,
  siTensorflow,
  siPytorch,
  siOnnx,
  siDatabricks,
  siDocker,
  siKubernetes,
  siJenkins,
  siTerraform,
  siRedhatopenshift,
  siPostgresql,
  siPytest,
  siSonarqubeserver,
} from 'simple-icons';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const heroWidths = [640, 1024, 1600, 1920];

async function buildResponsiveHero(src: typeof heroDarkSrc) {
  const variants = await Promise.all(
    heroWidths.map((width) => getImage({ src, width, format: 'webp', quality: 65 }))
  );
  return {
    src: variants[variants.length - 1].src,
    srcset: variants.map((v, i) => `${v.src} ${heroWidths[i]}w`).join(', '),
  };
}

const heroDark = await buildResponsiveHero(heroDarkSrc);
const heroLight = await buildResponsiveHero(heroLightSrc);

// Tier drives size in the skill cloud: lg = heaviest day-to-day use, sm = narrower/occasional use.
// Icon-less entries (no matching simple-icons logo) fall back to a plain text chip at the same tier size.
const skillGroups = [
  {
    label: 'Languages & Frameworks',
    skills: [
      { name: 'Python', icon: siPython, tier: 'lg' },
      { name: 'TypeScript', icon: siTypescript, tier: 'md' },
      { name: 'C++', icon: siCplusplus, tier: 'md' },
      { name: 'SQL', tier: 'md' },
      { name: 'FastAPI', icon: siFastapi, tier: 'md' },
      { name: 'React', icon: siReact, tier: 'sm' },
    ],
  },
  {
    label: 'ML & GenAI Orchestration',
    skills: [
      { name: 'LangGraph', icon: siLanggraph, tier: 'lg' },
      { name: 'MLflow 3.x', icon: siMlflow, tier: 'lg' },
      { name: 'LangChain', icon: siLangchain, tier: 'md' },
      { name: 'TensorFlow', icon: siTensorflow, tier: 'md' },
      { name: 'PyTorch', icon: siPytorch, tier: 'md' },
      { name: 'XGBoost', tier: 'md' },
      { name: 'ONNX', icon: siOnnx, tier: 'sm' },
      { name: 'RT-DETR', tier: 'sm' },
    ],
  },
  {
    label: 'MLOps & DevOps Infrastructure',
    skills: [
      { name: 'Databricks', icon: siDatabricks, tier: 'lg' },
      { name: 'Docker', icon: siDocker, tier: 'lg' },
      { name: 'Kubernetes', icon: siKubernetes, tier: 'lg' },
      { name: 'AWS', tier: 'lg' },
      { name: 'Jenkins', icon: siJenkins, tier: 'md' },
      { name: 'Terraform', icon: siTerraform, tier: 'md' },
      { name: 'Azure', tier: 'md' },
      { name: 'OpenShift (ARO)', icon: siRedhatopenshift, tier: 'sm' },
    ],
  },
  {
    label: 'Data & Quality',
    skills: [
      { name: 'PostgreSQL', icon: siPostgresql, tier: 'md' },
      { name: 'Pytest', icon: siPytest, tier: 'md' },
      { name: 'SonarQube', icon: siSonarqubeserver, tier: 'sm' },
      { name: 'Bandit', tier: 'sm' },
      { name: 'OAuth M2M', tier: 'sm' },
    ],
  },
] as const;
---

<BaseLayout
  title="Nibras Ahmed Nizar · MLOps Engineer, Agentic AI & GenAI Systems"
  description="MLOps Engineer and Technical Lead building production agentic AI and ML platforms at enterprise scale: LangGraph agents serving 300+ users, serverless model serving, and 50% cloud-cost reduction."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <img
      id="hero-img-dark"
      src={heroDark.src}
      srcset={heroDark.srcset}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 h-full w-full scale-110 object-cover object-[43%_52%] opacity-100 brightness-150 saturate-125 blur-md transition-opacity duration-700 ease-snappy"
    />
    <img
      id="hero-img-light"
      src={heroLight.src}
      srcset={heroLight.srcset}
      sizes="100vw"
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full scale-110 object-cover object-[47%_37%] opacity-0 blur-md transition-opacity duration-700 ease-snappy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-background/30 via-background/45 to-background dark:from-background/55 dark:via-background/70"
    >
    </div>

    <div class="relative mx-auto max-w-4xl px-6 py-24 sm:py-32">
      <div class="glass-panel mx-auto max-w-3xl rounded-[2.5rem] px-8 py-12 text-center sm:px-14 sm:py-16">
        <div class="flex justify-center">
          <AvailabilityBadge glass />
        </div>

        <h1
          class="mt-6 text-4xl font-semibold tracking-tight text-foreground [text-shadow:0_0_1px_rgb(255_255_255_/_1),0_0_4px_rgb(255_255_255_/_0.9),0_1px_18px_rgb(255_255_255_/_0.7)] sm:text-6xl dark:[text-shadow:0_2px_24px_rgb(0_0_0_/_0.25)]"
        >
          Nibras Ahmed Nizar
        </h1>
        <p class="glass mt-3 inline-block rounded-full px-4 py-1.5 font-mono text-lg text-accent [text-shadow:0_0_2px_rgb(255_255_255_/_1),0_1px_10px_rgb(255_255_255_/_0.85)] sm:text-xl dark:[text-shadow:0_0_2px_rgb(0_0_0_/_0.9),0_1px_4px_rgb(0_0_0_/_0.85),0_1px_14px_rgb(0_0_0_/_0.7)]">
          MLOps Engineer · Agentic AI & GenAI Systems
        </p>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground [text-shadow:0_0_1px_rgb(255_255_255_/_1),0_0_3px_rgb(255_255_255_/_0.95),0_1px_6px_rgb(255_255_255_/_0.9),0_1px_16px_rgb(255_255_255_/_0.8)] dark:[text-shadow:0_0_2px_rgb(0_0_0_/_0.9),0_1px_4px_rgb(0_0_0_/_0.85),0_1px_18px_rgb(0_0_0_/_0.75)]">
          I take ML systems from notebook to production: a LangGraph agent serving{' '}
          <span class="text-foreground dark:[text-shadow:0_0_2px_rgb(0_0_0_/_1),0_1px_5px_rgb(0_0_0_/_0.95),0_1px_20px_rgb(0_0_0_/_0.85)]">300+ users</span> at a semiconductor enterprise, and a
          serverless migration that cut quarterly cloud spend by{' '}
          <span class="text-foreground dark:[text-shadow:0_0_2px_rgb(0_0_0_/_1),0_1px_5px_rgb(0_0_0_/_0.95),0_1px_20px_rgb(0_0_0_/_0.85)]">50%</span>.
        </p>
        <p class="mx-auto mt-3 max-w-2xl font-mono text-sm text-muted-foreground [text-shadow:0_0_1px_rgb(255_255_255_/_1),0_0_3px_rgb(255_255_255_/_0.95),0_1px_6px_rgb(255_255_255_/_0.9),0_1px_16px_rgb(255_255_255_/_0.8)] dark:[text-shadow:0_0_2px_rgb(0_0_0_/_0.9),0_1px_4px_rgb(0_0_0_/_0.85),0_1px_18px_rgb(0_0_0_/_0.75)]">
          Production agentic AI + MLOps at enterprise scale · Arabic-speaking · Gulf-market-ready
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/projects"
            class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground transition-transform duration-200 ease-snappy hover:-translate-y-0.5 active:scale-[0.97] active:duration-100"
          >
            View work
          </a>
          <a
            href="/courses"
            class="glass rounded-md px-6 py-3 text-sm font-medium text-foreground transition-transform duration-200 ease-snappy hover:-translate-y-0.5 active:scale-[0.97] active:duration-100"
          >
            Courses
          </a>
          <a
            href="/resume.pdf"
            download
            class="glass rounded-md px-6 py-3 text-sm font-medium text-foreground transition-transform duration-200 ease-snappy hover:-translate-y-0.5 active:scale-[0.97] active:duration-100"
          >
            Download resume
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var darkImg = document.getElementById('hero-img-dark');
      var lightImg = document.getElementById('hero-img-light');
      if (!darkImg || !lightImg) return;
      function syncHeroBg() {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        darkImg.style.opacity = isLight ? '0' : '1';
        lightImg.style.opacity = isLight ? '1' : '0';
      }
      syncHeroBg();
      new MutationObserver(syncHeroBg).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    })();
  </script>

  <!-- Metric strip -->
  <section class="bg-gradient-to-b from-background via-accent/8 to-background">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        <MetricCounter value={6} suffix="+" label="Years of experience" />
        <MetricCounter value={300} suffix="+" label="Active agent users" />
        <MetricCounter value={50} suffix="%" label="Cloud cost cut" />
        <MetricCounter value={6} suffix="+" label="Production ML models" />
        <MetricCounter value={1.8} prefix="₹" decimals={1} suffix="M" label="ISRO grant secured" />
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      eyebrow="Selected work"
      title="Three ways I've moved the needle"
      description="Agentic AI in production, a platform migration that changed the cost model, and the architecture call that halved a budget line. Full case studies: problem, architecture, decisions, outcome."
    />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            summary={project.data.summary}
            stack={project.data.stack}
            headlineMetric={project.data.metrics[0]}
          />
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a href="/projects" class="font-mono text-sm text-accent hover:underline">
        See all 7 projects →
      </a>
    </div>
  </section>

  <!-- Social proof -->
  <section class="bg-gradient-to-b from-background via-accent/8 to-background">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="text-center sm:text-left">
          <p class="font-mono text-sm text-accent">Recognition</p>
          <p class="mt-2 text-sm text-muted-foreground">
            2× Intel "Above & Beyond" awards: Results Driven (2023) & Customer First (2022)
          </p>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-mono text-sm text-accent">Certified</p>
          <p class="mt-2 text-sm text-muted-foreground">
            AWS Certified Machine Learning – Specialty · MLOps Specialization, Duke University
          </p>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-mono text-sm text-accent">Trusted by</p>
          <p class="mt-2 text-sm text-muted-foreground">
            Teams at Intel · Applied Materials (via UST) · ISRO-funded research
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading eyebrow="Toolbox" title="Skills, grouped by how I actually use them" />

    <SkillCloud groups={skillGroups} />
  </section>
</BaseLayout>
