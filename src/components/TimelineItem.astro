---
interface Props {
  role: string;
  org: string;
  timeframe: string;
  headlineOutcome: string;
  isLast?: boolean;
}

const { role, org, timeframe, headlineOutcome, isLast = false } = Astro.props;
---

<div class="relative pl-8">
  <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full bg-accent"></span>
  {!isLast && <span class="absolute left-[4.5px] top-4 h-full w-px bg-border"></span>}

  <p class="font-mono text-xs text-muted-foreground">{timeframe}</p>
  <h3 class="mt-1 text-lg font-semibold text-foreground">
    {role} <span class="text-muted-foreground">· {org}</span>
  </h3>

  <div class="mt-3">
    <slot />
  </div>

  <p class="mt-3 font-mono text-sm text-accent">{headlineOutcome}</p>
</div>
