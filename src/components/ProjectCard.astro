---
import TagBadge from './TagBadge.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  stack: string[];
  headlineMetric?: { label: string; value: string };
}

const { href, title, summary, stack, headlineMetric } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col justify-between rounded-xl border border-border bg-primary/20 p-6 transition-all hover:-translate-y-1 hover:border-accent"
>
  <div>
    <h3 class="text-lg font-semibold text-foreground group-hover:text-accent">{title}</h3>
    <p class="mt-2 text-sm text-muted-foreground">{summary}</p>

    {
      headlineMetric && (
        <p class="mt-4 font-mono text-sm text-accent">
          {headlineMetric.value} <span class="text-muted-foreground">· {headlineMetric.label}</span>
        </p>
      )
    }

    <div class="mt-4 flex flex-wrap gap-2">
      {stack.slice(0, 4).map((tech) => <TagBadge label={tech} />)}
    </div>
  </div>

  <p class="mt-6 font-mono text-sm text-accent">
    Read case study
    <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">
      →
    </span>
  </p>
</a>
