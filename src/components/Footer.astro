---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-border/60 bg-primary/20">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-6 border-b border-border/60 pb-12 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-sm text-accent">Open to Senior MLOps / AI Platform roles</p>
        <h2 class="mt-2 text-2xl font-semibold text-foreground sm:text-3xl">Let's talk.</h2>
        <p class="mt-2 max-w-md text-sm text-muted-foreground">
          The easiest way to reach me is email. I reply within 24h.
        </p>
      </div>
      <a
        href={`mailto:${SITE.email}`}
        class="inline-flex w-fit items-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-semibold text-accent-foreground transition-transform hover:-translate-y-0.5"
      >
        {SITE.email}
      </a>
    </div>

    <div class="mt-8 flex flex-col gap-4 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Nibras Ahmed Nizar. Built with Astro.</p>
      <div class="flex gap-6">
        <a href={SITE.linkedin} class="transition-colors hover:text-accent" rel="me noopener noreferrer" target="_blank">
          LinkedIn
        </a>
        <a href={SITE.github} class="transition-colors hover:text-accent" rel="me noopener noreferrer" target="_blank">
          GitHub
        </a>
        <a href="/rss.xml" class="transition-colors hover:text-accent">RSS</a>
      </div>
    </div>
  </div>
</footer>
